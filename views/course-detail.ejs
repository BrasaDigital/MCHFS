    { src: 'module-2-2.jpg', en: 'Mother and newborn resting together, skin-to-skin, shortly after birth.', pt: 'Mãe e recém-nascido em repouso, pele a pele, pouco depois do parto.', fr: 'Mère et nouveau-né au repos, peau à peau, peu après la naissance.' }
  ],
  3: [
    { src: 'module-3.jpg', en: 'Mentor consulting with a mother and her baby at a maternity unit.', pt: 'Mentora em consulta com uma mãe e o seu bebé numa maternidade.', fr: 'La mentore en consultation avec une mère et son bébé dans une maternité.' },
    { src: 'module-3-2.jpg', en: 'Health professional attending to a young child at a maternity unit.', pt: 'Profissional de saúde a atender uma criança pequena numa maternidade.', fr: 'Professionnel de santé s\'occupant d\'un jeune enfant dans une maternité.' },
