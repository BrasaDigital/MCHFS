<% function cap(photo) { return photo[lang] || photo.en; } %>
<% var gallery = moduleGallery[module_.order_index]; %>

<section class="hero">
  <div class="container">
    <h1><%= pick(module_, 'title') %></h1>
    <% var desc = pick(module_, 'description'); %>
    <% if (desc) { %><p><%= desc %></p><% } %>
  </div>
  <% if (gallery && gallery.length === 1) { %>
    <img class="module-hero" src="/assets/<%= gallery[0].src %>"
      alt="<%= cap(gallery[0]) %>"
      loading="lazy" decoding="async">
  <% } else if (gallery && gallery.length > 1) { %>
    <div class="module-gallery">
      <div class="module-gallery-track">
        <% gallery.forEach(function (photo) { %>
          <img src="/assets/<%= photo.src %>" alt="<%= cap(photo) %>" loading="lazy" decoding="async">
        <% }); %>
      </div>
      <button type="button" class="gallery-arrow gallery-prev" data-gallery-prev aria-label="<%= lang === 'pt' ? 'Foto anterior' : lang === 'fr' ? 'Photo précédente' : 'Previous photo' %>">&#8249;</button>
      <button type="button" class="gallery-arrow gallery-next" data-gallery-next aria-label="<%= lang === 'pt' ? 'Próxima foto' : lang === 'fr' ? 'Photo suivante' : 'Next photo' %>">&#8250;</button>
    </div>
  <% } %>
</section>

<section>
  <div class="container">
    <% if (embedUrl) { %>
      <div style="position:relative; padding-top:56.25%; max-width:720px; margin-bottom:24px; background:var(--indigo-deep);">
        <iframe src="<%= embedUrl %>" title="<%= pick(module_, 'title') %>"
          style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;"
          loading="lazy" allowfullscreen></iframe>
      </div>
    <% } %>

    <% var content = pick(module_, 'content'); %>
    <% if (content) { %>
      <p style="white-space: pre-line;"><%= content %></p>
    <% } %>

    <% if (module_.pdf_filename) { %>
      <p><a class="btn btn-outline" href="<%= module_.pdf_filename %>" target="_blank" rel="noopener"><%= t('download_pdf') %></a></p>
    <% } %>
  </div>
</section>

<% if (questions && questions.length > 0) { %>
<section class="alt">
  <div class="container">
    <h2><%= t('quiz_title') %></h2>
    <p class="lead"><%= t('quiz_intro') %></p>

    <% if (lastAttempt) { %>
      <div class="quiz-result <%= lastAttempt.passed ? 'quiz-result-pass' : 'quiz-result-fail' %>">
        <strong><%= lastAttempt.passed ? t('quiz_result_passed') : t('quiz_result_failed') %></strong>
        <p class="mt-0"><%= t('quiz_last_attempt') %>: <%= t('quiz_score') %> <%= lastAttempt.score %>/<%= lastAttempt.total %> (<%= lastAttempt.percentage %>%)</p>
        <% if (lastAttempt.passed) { %>
          <p><a class="btn btn-primary" href="/certificate/<%= module_.id %>?lang=<%= lang %>"><%= t('quiz_view_certificate') %></a></p>
        <% } %>
      </div>
    <% } %>

    <form action="/courses/<%= module_.id %>/quiz?lang=<%= lang %>" method="post" class="quiz-form">
      <% questions.forEach(function(q, qi) { %>
        <div class="quiz-question">
          <p class="quiz-question-text"><strong><%= qi + 1 %>.</strong> <%= pick(q, 'question') %></p>
          <div class="quiz-options">
            <% ['a','b','c','d'].forEach(function(opt) { %>
              <label class="quiz-option">
                <input type="radio" name="q_<%= q.id %>" value="<%= opt %>" required>
                <span><%= pick(q, 'option_' + opt) %></span>
              </label>
            <% }); %>
          </div>
        </div>
      <% }); %>
      <button type="submit" class="btn btn-primary"><%= lastAttempt ? t('quiz_retry') : t('quiz_submit') %></button>
    </form>
  </div>
</section>
<% } %>

<section>
  <div class="container">
    <p><a href="/courses?lang=<%= lang %>">&larr; <%= t('course_back') %></a></p>
  </div>
</section>

<%- include('partials/foot') %>
