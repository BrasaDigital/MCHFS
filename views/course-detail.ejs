<%- include('partials/head', { title: lang === 'pt' ? module_.title_pt : module_.title_en, lang }) %>
<%- include('partials/nav', { lang, t, user }) %>

<% var moduleGallery = {
  1: [
    { src: 'module-1.jpg', en: 'Mentor and health team talking with a group of pregnant women during a birth-plan discussion.', pt: 'Mentora e equipa de saúde a conversar com um grupo de gestantes durante uma roda sobre plano de parto.' },
    { src: 'module-1-2.jpg', en: 'Mentor leading a birth-plan discussion circle with pregnant women.', pt: 'Mentora a conduzir uma roda sobre plano de parto com gestantes.' },
    { src: 'module-1-3.jpg', en: 'Breastfeeding counselling demonstration using a teaching model.', pt: 'Demonstração de aconselhamento sobre amamentação com modelo pedagógico.' }
  ],
  2: [
    { src: 'module-2.jpg', en: 'Skin-to-skin contact between mother and newborn, supported by the mentor.', pt: 'Contacto pele a pele entre mãe e recém-nascido, com o apoio da mentora.' },
    { src: 'module-2-2.jpg', en: 'Mother and newborn resting together, skin-to-skin, shortly after birth.', pt: 'Mãe e recém-nascido em repouso, pele a pele, pouco depois do parto.' }
  ],
  3: [
    { src: 'module-3.jpg', en: 'Mentor consulting with a mother and her baby at a maternity unit.', pt: 'Mentora em consulta com uma mãe e o seu bebé numa maternidade.' },
    { src: 'module-3-2.jpg', en: 'Health professional attending to a young child at a maternity unit.', pt: 'Profissional de saúde a atender uma criança pequena numa maternidade.' },
    { src: 'module-3-3.jpg', en: 'Health professional caring for a newborn on the postnatal ward.', pt: 'Profissional de saúde a cuidar de um recém-nascido na enfermaria pós-natal.' }
  ],
  5: [
    { src: 'module-5.jpg', en: 'Health worker checking a baby\'s growth during a consultation.', pt: 'Profissional de saúde a avaliar o crescimento de um bebé durante uma consulta.' },
    { src: 'module-5-2.jpg', en: 'Health team registering child-health consultations at a clinic.', pt: 'Equipa de saúde a registar consultas de saúde infantil numa clínica.' }
  ],
  6: [
    { src: 'module-6.jpg', en: 'Mentor leading a training workshop with frontline health professionals.', pt: 'Mentora a conduzir um workshop de formação com profissionais de saúde da linha da frente.' },
    { src: 'module-6-2.jpg', en: 'Health professionals taking part in an interactive training exercise.', pt: 'Profissionais de saúde a participar num exercício de formação interactivo.' },
    { src: 'module-6-3.jpg', en: 'Mentor presenting at an international seminar on maternal and child health.', pt: 'Mentora a apresentar num seminário internacional sobre saúde materna e infantil.' }
  ]
}; %>
<% var gallery = moduleGallery[module_.order_index]; %>

<section class="hero">
  <div class="container">
    <h1><%= lang === 'pt' ? module_.title_pt : module_.title_en %></h1>
    <% var desc = lang === 'pt' ? module_.description_pt : module_.description_en; %>
    <% if (desc) { %><p><%= desc %></p><% } %>
  </div>
  <% if (gallery && gallery.length === 1) { %>
    <img class="module-hero" src="/assets/<%= gallery[0].src %>"
      alt="<%= lang === 'pt' ? gallery[0].pt : gallery[0].en %>"
      loading="lazy" decoding="async">
  <% } else if (gallery && gallery.length > 1) { %>
    <div class="module-gallery">
      <div class="module-gallery-track">
        <% gallery.forEach(function (photo) { %>
          <img src="/assets/<%= photo.src %>" alt="<%= lang === 'pt' ? photo.pt : photo.en %>" loading="lazy" decoding="async">
        <% }); %>
      </div>
      <button type="button" class="gallery-arrow gallery-prev" data-gallery-prev aria-label="<%= lang === 'pt' ? 'Foto anterior' : 'Previous photo' %>">&#8249;</button>
      <button type="button" class="gallery-arrow gallery-next" data-gallery-next aria-label="<%= lang === 'pt' ? 'Próxima foto' : 'Next photo' %>">&#8250;</button>
    </div>
  <% } %>
</section>

<section>
  <div class="container">
    <% if (embedUrl) { %>
      <div style="position:relative; padding-top:56.25%; max-width:720px; margin-bottom:24px; background:var(--indigo-deep);">
        <iframe src="<%= embedUrl %>" title="<%= lang === 'pt' ? module_.title_pt : module_.title_en %>"
          style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;"
          loading="lazy" allowfullscreen></iframe>
      </div>
    <% } %>

    <% var content = lang === 'pt' ? module_.content_pt : module_.content_en; %>
    <% if (content) { %>
      <p style="white-space: pre-line;"><%= content %></p>
    <% } %>

    <% if (module_.pdf_filename) { %>
      <p><a class="btn btn-outline" href="<%= module_.pdf_filename %>" target="_blank" rel="noopener"><%= t('download_pdf') %></a></p>
    <% } %>
  </div>
</section>

<% if (questions && questions.length > 0) { %>
<section class="alt">
  <div class="container">
    <h2><%= t('quiz_title') %></h2>
    <p class="lead"><%= t('quiz_intro') %></p>

    <% if (lastAttempt) { %>
      <div class="quiz-result <%= lastAttempt.passed ? 'quiz-result-pass' : 'quiz-result-fail' %>">
        <strong><%= lastAttempt.passed ? t('quiz_result_passed') : t('quiz_result_failed') %></strong>
        <p class="mt-0"><%= t('quiz_last_attempt') %>: <%= t('quiz_score') %> <%= lastAttempt.score %>/<%= lastAttempt.total %> (<%= lastAttempt.percentage %>%)</p>
        <% if (lastAttempt.passed) { %>
          <p><a class="btn btn-primary" href="/certificate/<%= module_.id %>?lang=<%= lang %>"><%= t('quiz_view_certificate') %></a></p>
        <% } %>
      </div>
    <% } %>

    <form action="/courses/<%= module_.id %>/quiz?lang=<%= lang %>" method="post" class="quiz-form">
      <% questions.forEach(function(q, qi) { %>
        <div class="quiz-question">
          <p class="quiz-question-text"><strong><%= qi + 1 %>.</strong> <%= lang === 'pt' ? q.question_pt : q.question_en %></p>
          <div class="quiz-options">
            <% ['a','b','c','d'].forEach(function(opt) { %>
              <label class="quiz-option">
                <input type="radio" name="q_<%= q.id %>" value="<%= opt %>" required>
                <span><%= lang === 'pt' ? q['option_' + opt + '_pt'] : q['option_' + opt + '_en'] %></span>
              </label>
            <% }); %>
          </div>
        </div>
      <% }); %>
      <button type="submit" class="btn btn-primary"><%= lastAttempt ? t('quiz_retry') : t('quiz_submit') %></button>
    </form>
  </div>
</section>
<% } %>

<section>
  <div class="container">
    <p><a href="/courses?lang=<%= lang %>">&larr; <%= t('course_back') %></a></p>
  </div>
</section>

<%- include('partials/foot') %>
